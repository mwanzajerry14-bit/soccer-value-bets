# Copy this file to ".env" and fill in your own keys. Never commit .env.

# The Odds API -> https://the-odds-api.com/  (free tier: 500 requests/month)
ODDS_API_KEY=put_your_the_odds_api_key_here

# API-Football (api-sports.io) -> https://dashboard.api-football.com/register
# free tier: 100 requests/day
API_FOOTBALL_KEY=put_your_api_football_key_here
